#include <iostream>
#include <conio.h>
#include <string>

using namespace std;

// Function Prototypes
void DisplayBits(int bitfield);
void TurnOn(int& bitfield, int bitIndex);
void TurnOff(int& bitfield, int bitIndex);
void Toggle(int& bitfield, int bitIndex);
bool IsBitOn(int bitfield, int bitIndex);
void Negate(int& bitfield);
void RightShift(int& bitfield);
void LeftShift(int& bitfield);
void DrawBorder(string title, string lines[], int lineCount);
void BitManipulationLab();
void HexManipulationLab();
void OctalManipulationLab();

const int BOX_WIDTH = 60;
const int MAX_LINES = 20;

int main()
{
    char input;

    do
    {
        string menuLines[MAX_LINES] = {
            "1. Binary",
            "",
            "2. Hexadecimal",
            "",
            "3. Octal",
            "",
            "Escape: Exit"
        };
        DrawBorder("== Systems Programming - Bit Manipulation Lab ==", menuLines, 7);

        input = _getch();

        if (input == 27) break;

        if (input == '1')
        {
            BitManipulationLab();
        }
        if (input == '2')
        {
            HexManipulationLab();
        }
        if (input == '3')
        {
            OctalManipulationLab();
        }

    } while (true);

    return 0;
}

void BitManipulationLab()
{
    int bitfield = 16711935;
    int currentBit = 0;
    char input;

    do
    {
        string bitStatus = IsBitOn(bitfield, currentBit) ? "Bit Status: On" : "Bit Status: Off";
        string bitValue = "Bitfield Value: " + to_string(bitfield);

        // Build bits string - always show all 32 bits
        string bitsStr = "Bits: ";
        int i = 31;
        while (i >= 0)
        {
            bitsStr += to_string((bitfield >> i) & 1);
            i--;
        }

        // Build ^ indicator - always 32 bits
        string indicator = "      ";
        i = 31;
        while (i >= 0)
        {
            if (i == currentBit)
                indicator += "^";
            else
                indicator += " ";
            i--;
        }

        string labLines[MAX_LINES] = {
            bitValue,
            "",
            "    == Controls ==",
            "",
            "  I : Turn On        Q : Shift Left",
            "  O : Turn Off       E : Shift Right",
            "  Spc : Toggle       <- : Move Left",
            "  N : Negate         -> : Move Right",
            "",
            "    Escape : Main Menu",
            "",
            bitStatus,
            "",
            bitsStr,
            indicator
        };
        DrawBorder("== Binary ==", labLines, 15);

        input = _getch();

        if (input == 27) break;
        if (input == 'i' || input == 'I') TurnOn(bitfield, currentBit);
        if (input == 'o') TurnOff(bitfield, currentBit);
        if (input == ' ') Toggle(bitfield, currentBit);
        if (input == 'n' || input == 'N') Negate(bitfield);
        if (input == 'q' || input == 'Q') LeftShift(bitfield);
        if (input == 'e' || input == 'E') RightShift(bitfield);

        if ((unsigned char)input == 224)
        {
            input = _getch();

            if (input == 75)
            {
                currentBit++;
                if (currentBit > 31) currentBit = 0;
            }

            if (input == 77)
            {
                currentBit--;
                if (currentBit < 0) currentBit = 31;
            }
        }

        if (input == '>')
        {
            currentBit--;
            if (currentBit < 0) currentBit = 31;
        }

        if (input == '<')
        {
            currentBit++;
            if (currentBit > 31) currentBit = 0;
        }

    } while (true);
}

void HexManipulationLab()
{
    int bitfield = 16711935;
    int currentBit = 0;
    char input;

    do
    {
        string bitStatus = IsBitOn(bitfield, currentBit) ? "Bit Status: On" : "Bit Status: Off";

        // Build hex string manually - trim leading zeros, keep at least one digit
        string hexStr = "";
        unsigned int temp = (unsigned int)bitfield;
        bool leading = true;
        int i = 7;
        while (i >= 0)
        {
            int nibble = (temp >> (i * 4)) & 0xF;
            if (leading && nibble == 0 && i != 0)
            {
                i--;
                continue;
            }
            leading = false;
            if (nibble < 10)
                hexStr += (char)('0' + nibble);
            else
                hexStr += (char)('A' + nibble - 10);
            i--;
        }
        string bitValue = "Hex Field Value: 0x" + hexStr;

        // Build bits string - always show all 32 bits
        string bitsStr = "Bits: ";
        i = 31;
        while (i >= 0)
        {
            bitsStr += to_string((bitfield >> i) & 1);
            i--;
        }

        // Build ^ indicator - always 32 bits
        string indicator = "      ";
        i = 31;
        while (i >= 0)
        {
            if (i == currentBit)
                indicator += "^";
            else
                indicator += " ";
            i--;
        }

        string labLines[MAX_LINES] = {
            bitValue,
            "",
            "    == Controls ==",
            "",
            "  I : Turn On        Q : Shift Left",
            "  0 : Turn Off       E : Shift Right",
            "  Spc : Toggle       <- : Move Left",
            "  N : Negate         -> : Move Right",
            "",
            "    Escape : Main Menu",
            "",
            bitStatus,
            "",
            bitsStr,
            indicator
        };
        DrawBorder("== Hexadecimal ==", labLines, 15);

        input = _getch();

        if (input == 27) break;
        if (input == 'i' || input == 'I') TurnOn(bitfield, currentBit);
        if (input == '0') TurnOff(bitfield, currentBit);
        if (input == ' ') Toggle(bitfield, currentBit);
        if (input == 'n' || input == 'N') Negate(bitfield);
        if (input == 'q' || input == 'Q') LeftShift(bitfield);
        if (input == 'e' || input == 'E') RightShift(bitfield);

        if ((unsigned char)input == 224)
        {
            input = _getch();

            if (input == 75)
            {
                currentBit++;
                if (currentBit > 31) currentBit = 0;
            }

            if (input == 77)
            {
                currentBit--;
                if (currentBit < 0) currentBit = 31;
            }
        }

        if (input == '>')
        {
            currentBit--;
            if (currentBit < 0) currentBit = 31;
        }

        if (input == '<')
        {
            currentBit++;
            if (currentBit > 31) currentBit = 0;
        }

    } while (true);
}

void OctalManipulationLab()
{
    int bitfield = 16711935;
    int currentBit = 0;
    char input;

    do
    {
        string bitStatus = IsBitOn(bitfield, currentBit) ? "Bit Status: On" : "Bit Status: Off";

        // Build octal string manually - trim leading zeros
        string octStr = "";
        unsigned int temp = (unsigned int)bitfield;
        bool leading = true;

        int firstGroup = (temp >> 30) & 0x3;
        if (firstGroup != 0)
        {
            octStr += (char)('0' + firstGroup);
            leading = false;
        }

        int i = 29;
        while (i >= 0)
        {
            int group = (temp >> (i - 2)) & 0x7;
            if (leading && group == 0 && i != 2)
            {
                i -= 3;
                continue;
            }
            leading = false;
            octStr += (char)('0' + group);
            i -= 3;
        }

        if (octStr.empty()) octStr = "0";
        string bitValue = "Oct Field Value: " + octStr;

        // Build bits string - always show all 32 bits
        string bitsStr = "Bits: ";
        i = 31;
        while (i >= 0)
        {
            bitsStr += to_string((bitfield >> i) & 1);
            i--;
        }

        // Build ^ indicator - always 32 bits
        string indicator = "      ";
        i = 31;
        while (i >= 0)
        {
            if (i == currentBit)
                indicator += "^";
            else
                indicator += " ";
            i--;
        }

        string labLines[MAX_LINES] = {
            bitValue,
            "",
            "    == Controls ==",
            "",
            "  I : Turn On        Q : Shift Left",
            "  0 : Turn Off       E : Shift Right",
            "  Spc : Toggle       <- : Move Left",
            "  N : Negate         -> : Move Right",
            "",
            "    Escape : Main Menu",
            "",
            bitStatus,
            "",
            bitsStr,
            indicator
        };
        DrawBorder("== Octal ==", labLines, 15);

        input = _getch();

        if (input == 27) break;
        if (input == 'i' || input == 'I') TurnOn(bitfield, currentBit);
        if (input == '0') TurnOff(bitfield, currentBit);
        if (input == ' ') Toggle(bitfield, currentBit);
        if (input == 'n' || input == 'N') Negate(bitfield);
        if (input == 'q' || input == 'Q') LeftShift(bitfield);
        if (input == 'e' || input == 'E') RightShift(bitfield);

        if ((unsigned char)input == 224)
        {
            input = _getch();

            if (input == 75)
            {
                currentBit++;
                if (currentBit > 31) currentBit = 0;
            }

            if (input == 77)
            {
                currentBit--;
                if (currentBit < 0) currentBit = 31;
            }
        }

        if (input == '>')
        {
            currentBit--;
            if (currentBit < 0) currentBit = 31;
        }

        if (input == '<')
        {
            currentBit++;
            if (currentBit > 31) currentBit = 0;
        }

    } while (true);
}

void DrawBorder(string title, string lines[], int lineCount)
{
    system("cls");

    // Top border
    cout << "+" << string(BOX_WIDTH - 2, '-') << "+" << endl;

    // Empty line
    cout << "|" << string(BOX_WIDTH - 2, ' ') << "|" << endl;

    // Centered title
    int padding = (BOX_WIDTH - 2 - title.length()) / 2;
    cout << "|" << string(padding, ' ') << title
        << string(BOX_WIDTH - 2 - padding - title.length(), ' ') << "|" << endl;

    // Empty line after title
    cout << "|" << string(BOX_WIDTH - 2, ' ') << "|" << endl;

    // Content lines using while loop
    int i = 0;
    while (i < lineCount)
    {
        int p = (BOX_WIDTH - 2 - (int)lines[i].length()) / 2;
        if (p < 0) p = 0;
        cout << "|" << string(p, ' ') << lines[i]
            << string(BOX_WIDTH - 2 - p - (int)lines[i].length(), ' ') << "|" << endl;
        i++;
    }

    // Bottom border
    cout << "+" << string(BOX_WIDTH - 2, '-') << "+" << endl;
}

void DisplayBits(int bitfield)
{
    int i = 31;
    while (i >= 0)
    {
        cout << ((bitfield >> i) & 1);
        i--;
    }
    cout << endl;
}

void TurnOn(int& bitfield, int bitIndex) { bitfield = bitfield | (1 << bitIndex); }
void TurnOff(int& bitfield, int bitIndex) { bitfield = bitfield & ~(1 << bitIndex); }
void Toggle(int& bitfield, int bitIndex) { bitfield = bitfield ^ (1 << bitIndex); }
bool IsBitOn(int bitfield, int bitIndex) { return (bitfield & (1 << bitIndex)) != 0; }
void Negate(int& bitfield) { bitfield = ~bitfield; }
void RightShift(int& bitfield) { bitfield = bitfield >> 1; }
void LeftShift(int& bitfield) { bitfield = bitfield << 1; }
